# mcp-fleaflicker configuration.
#
# There is no API key: Fleaflicker's read API is public and unauthenticated.
# The one secret in this file is this server's own bearer token, below.

# REQUIRED for HTTP, which is the default transport and what docker compose
# runs. The server refuses to start over HTTP without a bearer token, and
# every client must then send `Authorization: Bearer <token>` to /mcp.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it in .env on the host only, readable by you alone (chmod 600 .env).
# Never put it in docker-compose.yml and never commit it.
MCP_AUTH_TOKEN=

# Local development over stdio needs no token. stdio is a local pipe with no
# network listener; select it with:
# MCP_TRANSPORT=stdio

# Default league. Optional: with it set, every tool's league_id argument can be
# omitted; without it, callers must pass league_id on each call.
# Find it in your league URL: fleaflicker.com/nfl/leagues/<league_id>
FLEAFLICKER_LEAGUE_ID=

# Sport. NFL is the only one this server has been verified against.
# FLEAFLICKER_SPORT=NFL

# Upstream base URL. Override only for testing against a mock.
# FLEAFLICKER_BASE_URL=https://www.fleaflicker.com/api

# Per-request timeout, seconds.
# FLEAFLICKER_TIMEOUT=30

# Logging: DEBUG | INFO | WARNING | ERROR, and text | json.
# LOG_LEVEL=INFO
# LOG_FORMAT=text
